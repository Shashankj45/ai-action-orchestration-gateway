APP_ENV=development
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
ALLOWED_HOSTS=*
DATABASE_URL=sqlite:///./gateway.db
LLM_PROVIDER=openai
LLM_API_KEY=placeholder-replace-with-real-key
LLM_MODEL=gpt-4o-mini
MAX_REQUEST_SIZE=10485760
RATE_LIMIT_PER_MINUTE=60
EXTERNAL_API_TIMEOUT=30

# Inbound Authentication & JWT (Phase 10A)
JWT_SECRET_KEY=change-this-to-a-secure-random-256-bit-hex-string-for-jwt-signing
JWT_ISSUER=guardrailed-ai-gateway
JWT_AUDIENCE=guardrailed-ai-gateway-api
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
INITIAL_ADMIN_USERNAME=admin
# If INITIAL_ADMIN_PASSWORD is unset, a 24-char cryptographic password is created on first startup
# and stored securely in .admin_bootstrap_secret with strict ACLs.
INITIAL_ADMIN_PASSWORD=
